@{
    ViewData["Title"] = "Home Page";
}

<div class="jumbotron p-4 p-md-5 mb-4 bg-light rounded-3">
    <h1>Contoso University</h1>
    <p class="lead">Welcome to Contoso University</p>
    <p>This sample application demonstrates how to use Entity Framework Core 8 in an ASP.NET Core 8 MVC application with Microsoft Entra ID authentication.</p>
</div>

<div class="row">
    <div class="col-md-3">
        <h2>Students</h2>
        <p>
            Add, edit, and delete students and view their enrollment records.
        </p>
        <p><a class="btn btn-secondary" href="/Students">Student List &raquo;</a></p>
    </div>
    <div class="col-md-3">
        <h2>Courses</h2>
        <p>Add, edit, and delete courses and assign them to departments.</p>
        <p><a class="btn btn-secondary" href="/Courses">Course List &raquo;</a></p>
    </div>
    <div class="col-md-3">
        <h2>Instructors</h2>
        <p>Add, edit, and delete instructors and assign them to courses.</p>
        <p><a class="btn btn-secondary" href="/Instructors">Instructor List &raquo;</a></p>
    </div>
    <div class="col-md-3">
        <h2>Departments</h2>
        <p>Add, edit, and delete departments and assign administrators.</p>
        <p><a class="btn btn-secondary" href="/Departments">Department List &raquo;</a></p>
    </div>
</div>

