@model ContosoUniversity.Web.Domain.Student

@{
    ViewData["Title"] = "Details";
}

<h2>Details</h2>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FirstMidName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstMidName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EnrollmentDate)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.EnrollmentDate)</dd>
    </dl>

    @if (Model.Enrollments != null && Model.Enrollments.Count > 0)
    {
        <h4>Enrollments</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>Course Title</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Enrollments)
                {
                    <tr>
                        <td>@item.Course?.Title</td>
                        <td>@item.Grade</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning">Edit</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
